{
  "name": "@rwa-verify/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rwa-verify/core": "workspace:*",
    "viem": "^2.56.3"
  },
  "description": "Read-side verification SDK for tokenised RWAs: ERC-3643/7943/4626 baseline plus ERC-8320/8325/8326/8328/8330 checks, viem readers, CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fepvenancio/rwa-verify.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/fepvenancio/rwa-verify#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "rwa-verify": "./dist/cli.js"
  }
}
