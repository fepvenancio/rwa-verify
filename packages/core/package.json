{
  "name": "@rwa-verify/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "description": "Shared types for rwa-verify: CheckResult, VerificationReport, AssetIdentity, pinned ERC spec refs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fepvenancio/rwa-verify.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/fepvenancio/rwa-verify#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
