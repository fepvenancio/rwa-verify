{
  "name": "rwa-verify",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:sol": "forge test --root packages/solidity",
    "typecheck": "pnpm -r typecheck",
    "test:diff": "forge test --root packages/solidity --profile diff",
    "test:e2e": "pnpm --filter @rwa-verify/readers exec vitest run src/e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "fast-check": "^4.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
