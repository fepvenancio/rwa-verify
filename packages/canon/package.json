{
  "name": "@rwa-verify/canon",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@rwa-verify/core": "workspace:*",
    "@xmldom/xmldom": "^0.9.12"
  },
  "bin": {
    "rwa-canon": "./dist/cli.js"
  },
  "description": "ERC-8326 canonicaliser and bundle hash: RFC 8785 JSON, Canonical XML 1.1, filename/MIME hashing, CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fepvenancio/rwa-verify.git",
    "directory": "packages/canon"
  },
  "homepage": "https://github.com/fepvenancio/rwa-verify#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
